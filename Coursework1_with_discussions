    "        ax.step(x, 1 - np.arange(len(x)) / len(x), where=\"post\", color=c, label=f\"{lab} (n = {len(x)})\")\n",
    "    xx = np.linspace(0, max(len_real[st_real == i].max(), len_sim[st_sim == i].max()) / fs, 300)\n",
    "    ax.plot(xx, T[i, i] ** (xx * fs), \"C2--\", label=r\"geometric theory $T_{ii}^{\\,k}$\")\n",
    "    ax.set_yscale(\"log\"); ax.set_ylim(1 / (3 * (st_real == i).sum()), 1.3)\n",
    "    ks = stats.ks_2samp(len_real[st_real == i], len_sim[st_sim == i])\n",
