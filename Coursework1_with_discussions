    "# ---- does running affect the reliability of the population response? cross-repeat recurrence ----\n",
    "def cross_repeat(Y, eps):\n",
    "    \"\"\"For repeats i != j: is the population state at the same movie time within ε? -> repeats x repeats x bins.\"\"\"\n",
    "    Ytr = Y[:n_rep * nb].reshape(n_rep, nb, -1)\n",
    "    return np.linalg.norm(Ytr[:, None] - Ytr[None, :], axis=-1) <= eps\n",
    "\n",
    "run_bins = {\"Real\": bin_time(trial_aligned(state[None, mov0:mov1].astype(float))[0].reshape(1, -1))[0].reshape(n_rep, nb) > 0.5,\n",
