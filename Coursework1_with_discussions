    "    ax.set_xlabel(\"Time within movie (s)\"); ax.set_ylabel(\"Repeat\"); ax.set_ylim(0.4, n_rep + 0.6)\n",
    "    ax.set_title(f\"{name}: raster of neuron {ex} (baseline {rates[ex]:.1f} Hz)\")\n",
