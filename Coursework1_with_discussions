    "SPEED_THR = 2.0          # cm/s: threshold between stationary (0) and running (1)\n",
    "SMOOTH_S = 1.0           # s: running-median filter applied before thresholding (removes encoder jitter)\n",
    "\n",
    "speed_smooth = median_filter(speed, size=int(round(SMOOTH_S * fs)))\n",
    "state = (speed_smooth > SPEED_THR).astype(int)\n",
    "\n",
    "def fit_markov(s):\n",
    "    \"\"\"Left-stochastic transition matrix as in the lectures: T[j, i] = P(s_{n+1} = j | s_n = i); columns sum to 1.\"\"\"\n",
    "    n = np.zeros((2, 2))\n",
    "    np.add.at(n, (s[1:], s[:-1]), 1)\n",
    "    return n / n.sum(0, keepdims=True)\n",
    "\n",
    "def bouts(s):\n",
    "    \"\"\"Bout lengths (frames) and their states, dropping the first and last bouts (censored by the recording edges).\"\"\"\n",
    "    change = np.flatnonzero(np.diff(s)) + 1\n",
    "    starts, ends = np.r_[0, change], np.r_[change, len(s)]\n",
    "    return (ends - starts)[1:-1], s[starts][1:-1]\n",
    "\n",
    "fig, axs = plt.subplots(1, 2, figsize=(13, 3.8))\n",
    "axs[0].hist(speed_smooth, bins=np.arange(-3, 40, 0.5), color=\"0.4\")\n",
