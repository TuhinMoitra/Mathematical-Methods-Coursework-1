    "axs[1].fill_between(t[seg], 0, state[seg] * speed[seg].max(), color=\"C1\", alpha=0.2, label=\"running state\")\n",
    "axs[1].axhline(SPEED_THR, color=\"C3\", ls=\"--\"); axs[1].set_xlabel(\"Time (s)\"); axs[1].set_ylabel(\"Speed (cm/s)\")\n",
