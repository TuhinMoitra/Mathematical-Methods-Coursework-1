    "def cmdscale(D):\n",
    "    \"\"\"Classical MDS (as in the lecture demo_w6.py): double-centre -D²/2 and eigendecompose.\"\"\"\n",
    "    n = len(D); H = np.eye(n) - np.ones((n, n)) / n\n",
    "    B = -H @ (D ** 2) @ H / 2\n",
    "    evals, evecs = np.linalg.eigh(B)\n",
    "    idx = np.argsort(evals)[::-1]; evals, evecs = evals[idx], evecs[:, idx]\n",
    "    w = np.flatnonzero(evals > 0)\n",
    "    return evecs[:, w] * np.sqrt(evals[w]), evals\n",
    "\n",
    "# gratings: cosine dissimilarity between presentation response vectors\n",
    "Dg = 1 - cosine_similarity(resp)\n",
    "Mg, eg = cmdscale(Dg)\n",
