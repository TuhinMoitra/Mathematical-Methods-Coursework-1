    "len_sim, st_sim = bouts(state_sim)\n",
    "print(f\"Simulated fraction running = {state_sim.mean():.3f} (real {state.mean():.3f})\")\n",
    "\n",
    "fig, axs = plt.subplots(2, 2, figsize=(13, 8))\n",
    "for i, name in enumerate([\"Stationary\", \"Running\"]):\n",
