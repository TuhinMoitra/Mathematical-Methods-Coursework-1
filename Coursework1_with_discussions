    "def mean_acf(X, max_lag):\n",
    "    X = X - X.mean(1, keepdims=True); n = X.shape[1]\n",
    "    f = np.fft.rfft(X, n=2 * n, axis=1)\n",
    "    ac = np.fft.irfft(f * np.conj(f), axis=1)[:, :max_lag + 1]\n",
    "    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n",
    "        ac = ac / ac[:, :1]\n",
    "    return np.nanmean(ac, 0), np.nanpercentile(ac, [25, 75], axis=0)\n",
    "\n",
    "data_mov = {\"Real\": dff_mov, \"Surrogate A\": dffA, \"Surrogate B\": dffB}\n",
    "max_lag = int(70 * fs); lags = np.arange(max_lag + 1) / fs\n",
    "fig, axs = plt.subplots(1, 3, figsize=(16, 4.2))\n",
    "for name, X in data_mov.items():\n",
    "    m, iqr = mean_acf(X, max_lag)\n",
    "    for ax in axs[:2]:\n",
    "        ax.plot(lags, m, color=COL[name], label=name); ax.fill_between(lags, iqr[0], iqr[1], color=COL[name], alpha=0.12)\n",
    "axs[0].plot(lags, np.exp(-lags / TAU_DECAY), \"C2:\", label=f\"exp(-lag/τ), τ = {TAU_DECAY} s\")\n",
    "axs[0].set_xlim(0, 5); axs[0].set_title(\"Autocorrelation, short lags\")\n",
    "axs[1].set_title(\"Autocorrelation, long lags (movie period 30 s)\")\n",
    "for k in (1, 2):\n",
    "    axs[1].axvline(30 * k, color=\"0.6\", ls=\":\")\n",
    "for ax in axs[:2]:\n",
    "    ax.set_xlabel(\"Lag (s)\"); ax.set_ylabel(\"ACF (mean, IQR over cells)\"); ax.axhline(0, color=\"0.8\", lw=0.8)\n",
