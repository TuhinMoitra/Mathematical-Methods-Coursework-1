    "def acf1(x, max_lag):\n",
    "    x = x - x.mean(); n = len(x)\n",
    "    f = np.fft.rfft(x, 2 * n)\n",
    "    a = np.fft.irfft(f * np.conj(f))[:max_lag + 1]\n",
    "    return a / a[0]\n",
    "\n",
    "def ami(x, max_lag, bins=16):\n",
    "    # equiprobable (\"uniform count\") bins, as recommended by Timme & Lapish (2018)\n",
    "    \"\"\"Auto mutual information I(x_t; x_{t+lag}) in bits, plug-in estimator with equiprobable bins.\"\"\"\n",
    "    q = np.quantile(x, np.linspace(0, 1, bins + 1)[1:-1]); xi = np.searchsorted(q, x)\n",
    "    out = np.empty(max_lag + 1)\n",
    "    for lag in range(max_lag + 1):\n",
    "        a, b = xi[:len(x) - lag], xi[lag:]\n",
    "        joint = np.bincount(a * bins + b, minlength=bins * bins).reshape(bins, bins) / len(a)\n",
    "        pa, pb = joint.sum(1), joint.sum(0); nz = joint > 0\n",
    "        out[lag] = np.sum(joint[nz] * np.log2(joint[nz] / np.outer(pa, pb)[nz]))\n",
    "    return out\n",
    "\n",
    "def first_local_min(y):\n",
    "    for k in range(1, len(y) - 1):\n",
    "        if y[k] < y[k - 1] and y[k] <= y[k + 1]:\n",
    "            return k\n",
    "    return None\n",
    "\n",
    "def first_zero(y):\n",
    "    z = np.flatnonzero(y <= 0)\n",
    "    return int(z[0]) if len(z) else None\n",
    "\n",
    "MAX_LAG_TAU = int(15 * fs)\n",
    "acfs, amis, rows = {}, {}, []\n",
    "for key, x in signals.items():\n",
    "    acfs[key], amis[key] = acf1(x, MAX_LAG_TAU), ami(x, MAX_LAG_TAU)\n",
    "    rows.append(dict(signal=key[0], dataset=key[1], ACF_first_zero=first_zero(acfs[key]),\n",
    "                     ACF_1_over_e=int(np.argmax(acfs[key] < 1 / np.e)), AMI_first_min=first_local_min(amis[key])))\n",
    "tau_df = pd.DataFrame(rows)\n",
    "# criterion: first minimum of the AMI; if there is none in the window, fall back to the first zero of the ACF\n",
    "tau_df[\"tau_frames\"] = tau_df.AMI_first_min.fillna(tau_df.ACF_first_zero).astype(int)\n",
    "tau_df[\"tau_s\"] = (tau_df.tau_frames / fs).round(2)\n",
    "TAU = {(r.signal, r.dataset): int(r.tau_frames) for r in tau_df.itertuples()}\n",
    "# Panzeri-Treves estimate of the plug-in bias (Pola et al. 2003): (1/(2N ln2))[Σ_s(R_s-1) - (R-1)], with 16 x 16 bins\n",
