    "fig.tight_layout(); plt.show()\n",
    "\n",
    "# ---- spike-train statistics from the lectures: CV of ISIs and Fano factor ----\n",
    "def fano(counts):\n",
    "    \"\"\"Fano factor = variance / mean of spike counts (unbiased variance: matters with only 10 repeats).\"\"\"\n",
    "    return counts.var(-1, ddof=1) / np.maximum(counts.mean(-1), 1e-12)\n",
    "\n",
    "def win_counts(sp, edges):\n",
    "    return np.histogram(sp, edges)[0]\n",
    "\n",
    "def cv2_mean(isi):\n",
    "    \"\"\"Holt et al. (1996) CV2: compares only adjacent ISIs, 2|Δt_{i+1} - Δt_i| / (Δt_{i+1} + Δt_i), averaged.\n",
    "    It is ~1 for a Poisson process and, unlike CV, almost insensitive to slow changes in firing rate.\"\"\"\n",
    "    return np.mean(2 * np.abs(np.diff(isi)) / (isi[1:] + isi[:-1]))\n",
