    "    u = rng.random(n)\n",
    "    for k in range(1, n):\n",
    "        s[k] = int(u[k] < T[1, s[k - 1]])        # P(next = running | current state)\n",
    "    return s\n",
    "\n",
    "rng_markov = np.random.default_rng(SEED + 1)\n",
    "state_sim = simulate_markov(T, len(state), state[0], rng_markov)\n",
