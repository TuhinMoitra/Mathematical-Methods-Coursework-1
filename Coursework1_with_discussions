    "# ---- sensitivity of the conclusions to K_PC and to ε (via RR), as recommended by Bradley & Kantz (2015) ----\n",
    "def rqa_summary(Y, rr):\n",
    "    D = squareform(pdist(Y)); eps = np.quantile(D[np.triu_indices_from(D, 1)], rr); R = D <= eps\n",
    "    rl = rr_vs_lag(R)\n",
    "    peak, base = rl[nb - 2:nb + 3].max(), rl[nb // 2 - 2:nb // 2 + 3].mean()\n",
    "    return peak / max(base, 1e-4), rqa(R, theiler, lmin=5)[1]\n",
    "\n",
    "src = {name: mov_concat[name] for name in DS}; src[\"Spontaneous\"] = dff_spont\n",
    "settings = [(k, RR_TARGET) for k in (5, 10, 20, 50)] + [(K_PC, rr) for rr in (0.02, 0.10)]\n",
    "rows = []\n",
    "for k, rr in settings:\n",
    "    row = {\"K_PC\": k, \"RR\": rr}\n",
    "    for name in names4:\n",
    "        Y = pop[name] if k == K_PC else pop_state(src[name], k)[0]\n",
    "        ratio, det5 = rqa_summary(Y, rr)\n",
    "        row[f\"{name}: RR(30 s)/RR(15 s)\"] = ratio; row[f\"{name}: DET (lmin=5)\"] = det5\n",
    "    rows.append(row)\n",
    "sens = pd.DataFrame(rows).set_index([\"K_PC\", \"RR\"])\n",
    "display(sens[[c for c in sens.columns if \"RR(30\" in c]].round(2))\n",
    "display(sens[[c for c in sens.columns if \"DET\" in c]].round(3))"
