    "def runs_of_ones(v):\n",
    "    v = np.r_[0, v.astype(np.int8), 0]; dv = np.diff(v)\n",
    "    return np.flatnonzero(dv == -1) - np.flatnonzero(dv == 1)\n",
    "\n",
    "def rqa(R, theiler, lmin=LMIN):\n",
    "    \"\"\"Recurrence rate and determinism over the upper triangle, excluding diagonals inside the Theiler window.\"\"\"\n",
    "    n_rec = n_line = n_tot = 0\n",
    "    for k in range(theiler + 1, R.shape[0]):\n",
    "        diag = np.diagonal(R, k); n_tot += len(diag)\n",
    "        runs = runs_of_ones(diag); n_rec += runs.sum(); n_line += runs[runs >= lmin].sum()\n",
    "    return n_rec / n_tot, n_line / max(n_rec, 1)\n",
    "\n",
    "def rr_vs_lag(R):\n",
    "    return np.array([np.diagonal(R, k).mean() for k in range(R.shape[0])])\n",
    "\n",
    "theiler = int(round(THEILER_S * fs_bin))\n",
    "nb = L // BIN                                    # bins per movie repeat (one 30-s period)\n",
    "names4 = [\"Real\", \"Surrogate A\", \"Surrogate B\", \"Spontaneous\"]\n",
    "fig, ax = plt.subplots(figsize=(13, 4.2))\n",
    "rrl = {}\n",
    "for name in names4:\n",
    "    rrl[name] = rr_vs_lag(RP[name])\n",
    "    ax.plot(np.arange(len(rrl[name])) / fs_bin, rrl[name], color=COL[name], lw=0.9, label=name)\n",
    "for k in range(1, 10):\n",
    "    ax.axvline(k * L / fs, color=\"0.7\", ls=\":\", lw=0.8)\n",
    "ax.set_yscale(\"log\"); ax.set_xlabel(\"Lag (s)\"); ax.set_ylabel(\"Recurrence rate on diagonal\")\n",
    "ax.set_title(\"Recurrence rate as a function of lag (dotted: multiples of the 30-s movie)\"); ax.legend()\n",
    "fig.tight_layout(); plt.show()\n",
    "\n",
    "rows = []\n",
