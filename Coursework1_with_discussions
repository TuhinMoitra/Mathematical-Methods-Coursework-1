    "def isi_density_inhom(lam_hz, taus_ms, ds=5):\n",
    "    \"\"\"Theoretical ISI density (per ms) of an inhomogeneous Poisson process with known λ(t) (Hz, on the SIM_DT grid):\n",
    "       p(τ) ∝ Σ_t λ(t) λ(t+τ) exp(-∫_t^{t+τ} λ), evaluated on a ds-ms grid.\"\"\"\n",
    "    lam = lam_hz[: len(lam_hz) // ds * ds].reshape(-1, ds).mean(1)\n",
    "    dtg = SIM_DT * ds\n",
    "    Lam = np.r_[0, np.cumsum(lam * dtg)]\n",
    "    p = np.empty(len(taus_ms))\n",
    "    for n, tau in enumerate(taus_ms):\n",
    "        k = max(int(round(tau * 1e-3 / dtg)), 1)\n",
    "        p[n] = np.sum(lam[:-k] * lam[k:] * np.exp(-(Lam[k:-1] - Lam[:-k - 1])))\n",
    "    return p / np.trapz(p, taus_ms)\n",
    "\n",
    "ex = int(np.argmin(np.abs(rates - 5.0)))           # example neuron: baseline rate closest to 5 Hz\n",
