    "def embed(x, m, tau):\n",
    "    n = len(x) - (m - 1) * tau\n",
    "    return np.column_stack([x[i * tau:i * tau + n] for i in range(m)])\n",
    "\n",
    "FNN_RTOL, FNN_ATOL = 15.0, 2.0        # Kennel et al. (1992) thresholds\n",
    "THEILER_FNN = int(0.5 * fs)            # exclude neighbours closer than 0.5 s in time (same transient)\n",
    "\n",
    "def fnn_fraction(x, tau, m_max=10, rtol=FNN_RTOL, atol=FNN_ATOL, theiler=THEILER_FNN):\n",
    "    sd = np.std(x); out = []\n",
    "    k_query = 2 * theiler + 2          # at most 2*theiler+1 points lie inside the window, so this finds the true neighbour\n",
    "    for m in range(1, m_max + 1):\n",
    "        E = embed(x, m + 1, tau); Y = E[:, :m]\n",
    "        dist, ind = cKDTree(Y).query(Y, k=k_query)\n",
    "        ok = np.abs(ind - np.arange(len(Y))[:, None]) > theiler\n",
    "        i = np.flatnonzero(ok.any(1)); first = np.argmax(ok, axis=1)[i]\n",
    "        j, Rm = ind[i, first], dist[i, first]\n",
    "        keep = Rm > 0; i, j, Rm = i[keep], j[keep], Rm[keep]\n",
    "        extra = np.abs(E[i, m] - E[j, m])                          # distance added by the (m+1)-th coordinate\n",
    "        false = (extra / Rm > rtol) | (np.sqrt(Rm ** 2 + extra ** 2) / sd > atol)\n",
    "        out.append(false.mean())\n",
    "    return np.array(out)\n",
    "\n",
    "M_MAX = 10; ms = np.arange(1, M_MAX + 1)\n",
    "fnn = {key: fnn_fraction(x, TAU[key], M_MAX) for key, x in signals.items()}\n",
    "fnn_clean = {kind: fnn_fraction(signals_clean[kind], TAU[(kind, \"Surrogate B\")], M_MAX) for kind in [\"Neuron\", \"PC1\"]}\n",
    "\n",
    "# ---- surrogate-data test (Theiler et al. 1992; Bradley & Kantz 2015): IAAFT surrogates of the REAL signals keep the\n",
    "# power spectrum (hence the ACF) and the amplitude distribution but are otherwise random, i.e. a linear stochastic\n",
    "# null hypothesis. If the real FNN curve lies inside the surrogate range there is no evidence for nonlinear determinism.\n",
    "def iaaft(x, rng, n_iter=100):\n",
    "    \"\"\"Iterative amplitude-adjusted Fourier-transform surrogate (Schreiber & Schmitz 1996).\"\"\"\n",
    "    x_sorted, amp = np.sort(x), np.abs(np.fft.rfft(x))\n",
    "    y = rng.permutation(x)\n",
    "    for _ in range(n_iter):\n",
    "        Y = np.fft.rfft(y)\n",
    "        y = np.fft.irfft(amp * np.exp(1j * np.angle(Y)), n=len(x))     # impose the spectrum\n",
    "        y = x_sorted[np.argsort(np.argsort(y))]                         # impose the amplitude distribution\n",
    "    return y\n",
    "\n",
    "N_SURR = 19                                                             # 19 surrogates -> one-sided rank test at p = 0.05\n",
    "rng_surr = np.random.default_rng(SEED + 6)\n",
    "fnn_surr = {kind: np.array([fnn_fraction(iaaft(signals[(kind, \"Real\")], rng_surr), TAU[(kind, \"Real\")], M_MAX)\n",
