    "# ---- the 10 repeats of natural_movie_one: indices, trial alignment and helper functions ----\n",
    "rep_start = np.searchsorted(t, mt[\"start\"].values)\n",
    "rep_stop = np.searchsorted(t, mt[\"stop\"].values)\n",
    "L = int(np.min(rep_stop - rep_start))            # frames per repeat (903 = 30.0 s)\n",
    "n_rep = len(mt)\n",
    "mov0, mov1 = rep_start[0], rep_stop[-1]          # contiguous movie window (all 10 repeats)\n",
    "n_mov = mov1 - mov0\n",
    "rep_off = rep_start - mov0                       # repeat onsets relative to the window\n",
    "movie_time = np.arange(L) / fs                   # time within the movie (s)\n",
    "\n",
    "def trial_aligned(X):\n",
    "    \"\"\"cells x frames (movie window) -> cells x repeats x L, aligned to repeat onset.\"\"\"\n",
    "    return X[:, rep_off[:, None] + np.arange(L)]\n",
    "\n",
    "def concat_trials(X):\n",
    "    \"\"\"cells x (repeats*L): the 10 aligned repeats concatenated.\"\"\"\n",
    "    return trial_aligned(X).reshape(X.shape[0], -1)\n",
    "\n",
    "def reliability(Xtr):\n",
    "    \"\"\"Mean pairwise Pearson correlation between repeats, for each cell (Xtr: cells x repeats x L).\"\"\"\n",
    "    Z = (Xtr - Xtr.mean(-1, keepdims=True)) / (Xtr.std(-1, keepdims=True) + 1e-12)\n",
    "    C = np.einsum(\"crl,csl->crs\", Z, Z) / Z.shape[-1]\n",
    "    n = Z.shape[1]\n",
    "    return (C.sum((1, 2)) - n) / (n * (n - 1))\n",
    "\n",
    "def oracle_score(Xtr):\n",
    "    \"\"\"MICrONS-style 'oracle' reliability: mean over repeats of the correlation between each repeat and the\n",
    "    leave-one-out mean of the other repeats (MICrONS Consortium 2025, Methods).\"\"\"\n",
    "    n = Xtr.shape[1]\n",
    "    loo = (Xtr.sum(1, keepdims=True) - Xtr) / (n - 1)\n",
    "    a, b = Xtr - Xtr.mean(-1, keepdims=True), loo - loo.mean(-1, keepdims=True)\n",
    "    return ((a * b).sum(-1) / np.sqrt((a * a).sum(-1) * (b * b).sum(-1) + 1e-24)).mean(1)\n",
    "\n",
    "def zscore_rows(X):\n",
    "    m, s = X.mean(1, keepdims=True), X.std(1, keepdims=True)\n",
    "    s[s == 0] = 1\n",
    "    return (X - m) / s\n",
    "\n",
    "dff_mov = dff[:, mov0:mov1]\n",
    "rel_real = reliability(trial_aligned(dff_mov))\n",
    "oracle_real = oracle_score(trial_aligned(dff_mov))\n",
    "movie_time_concat = np.tile(movie_time, n_rep)\n",
    "print(f\"{n_rep} movie repeats x {L} frames ({L / fs:.2f} s each); movie window = {n_mov} frames\")"
   ]
