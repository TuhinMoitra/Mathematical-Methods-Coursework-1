    "RESP_WIN = (0.0, 2.0)       # s after onset: the full 2-s presentation\n",
    "BASE_WIN = (-0.5, 0.0)      # s: the end of the preceding 1-s grey interval\n",
    "\n",
    "g = gt[~gt.is_blank].reset_index(drop=True)\n",
    "on = g[\"start\"].values\n",
    "i0, i1 = np.searchsorted(t, on + RESP_WIN[0]), np.searchsorted(t, on + RESP_WIN[1])\n",
    "b0, b1 = np.searchsorted(t, on + BASE_WIN[0]), np.searchsorted(t, on + BASE_WIN[1])\n",
    "cs = np.c_[np.zeros((N, 1)), np.cumsum(dff, axis=1)]\n",
    "resp = ((cs[:, i1] - cs[:, i0]) / (i1 - i0) - (cs[:, b1] - cs[:, b0]) / (b1 - b0)).T       # presentations x cells\n",
    "cs_sp = np.r_[0, np.cumsum(speed_smooth)]\n",
    "g[\"running\"] = ((cs_sp[i1] - cs_sp[i0]) / (i1 - i0)) > SPEED_THR\n",
    "print(f\"{len(g)} non-blank presentations ({g.direction_deg.nunique()} directions x {g.temporal_freq_hz.nunique()} TFs); \"\n",
    "      f\"{100 * g.running.mean():.1f}% during running\")\n",
    "\n",
    "STANDARDISE_G = False   # False: covariance PCA of the ΔF/F responses (all cells in the same units; Lever et al. 2017)\n",
    "                        # True: correlation PCA (each cell z-scored across presentations). Both are computed and compared.\n",
    "Xg = {\"covariance (ΔF/F)\": resp - resp.mean(0), \"z-scored cells\": (resp - resp.mean(0)) / resp.std(0)}\n",
    "pcas_g = {lab: PCA(random_state=SEED).fit(X) for lab, X in Xg.items()}\n",
    "main_g = \"z-scored cells\" if STANDARDISE_G else \"covariance (ΔF/F)\"\n",
    "pca_g = pcas_g[main_g]\n",
    "Sg = pca_g.transform(Xg[main_g])                  # scores used in the figures below\n",
    "Zg = Xg[\"z-scored cells\"]\n",
    "\n",
    "fig, axs = plt.subplots(1, 2, figsize=(14, 3.8), sharey=True)\n",
    "k = np.arange(1, 41)\n",
    "for ax, (lab, p) in zip(axs, pcas_g.items()):\n",
    "    ax.bar(k, 100 * p.explained_variance_ratio_[:40], color=\"0.5\", label=\"per component\")\n",
